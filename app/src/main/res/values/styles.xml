<resources>
    <string name="app_name">Sillytavern App</string>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/jg_accent</item>
        <item name="android:windowBackground">@color/jg_background</item>
        <item name="android:colorBackground">@color/jg_background</item>
        <item name="android:windowLightStatusBar">true</item>
